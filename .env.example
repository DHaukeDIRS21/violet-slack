# Slack (api.slack.com/apps → Violet)
SLACK_BOT_TOKEN=xoxb-...        # OAuth & Permissions → Bot User OAuth Token
SLACK_USER_TOKEN=xoxp-...       # OAuth & Permissions → User OAuth Token (von dir autorisiert)
SLACK_APP_TOKEN=xapp-...        # Basic Information → App-Level Token mit connections:write

# Claude
ANTHROPIC_API_KEY=sk-ant-...

